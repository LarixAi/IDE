# CodeMe local + remote model configuration.
#
# n8n is installed but disabled for the current CodeMe-only runtime.
# Set CODEME_N8N_ENABLED=true later when the integration is intentionally restored.
CODEME_N8N_ENABLED=false
CODEME_N8N_URL=http://127.0.0.1:5678
CODEME_N8N_TOKEN=

# Optional shared capability gateway. Leave blank to keep the existing per-capability webhooks.
# When enabled, only the listed capabilities are sent through the gateway.
CODEME_N8N_GATEWAY_PATH=
CODEME_N8N_GATEWAY_CAPABILITIES=research.problem

# Prompt Enhancement gate. CodeMe uses this before a new agent run.
CODEME_N8N_ENHANCE_URL=http://127.0.0.1:5678/webhook/prompt.enrich
CODEME_N8N_AUTO_ENHANCE=false
# Allow the local 9B prompt enhancer enough time for structured JSON output.
CODEME_N8N_ENHANCE_TIMEOUT_MS=200000

# n8n's MCP server (Settings -> MCP access). Keep the bearer token only in
# your local .env; never commit it.
CODEME_N8N_MCP_URL=http://127.0.0.1:5678/mcp-server/http
CODEME_N8N_MCP_TOKEN=

# Browser Harness candidate replacement. This stays disabled by default while
# CodeMe compares it against the existing browser.check/browser.interact runner.
# Enable from CodeMe Settings -> Browser & Preview. These environment values
# only override how the candidate MCP process is launched.
CODEME_BROWSER_HARNESS_COMMAND=uvx
CODEME_BROWSER_HARNESS_PACKAGE='browser-harness[mcp]==0.1.13'
CODEME_BROWSER_HARNESS_ALLOW_RECORDING=false

# Native Research Engineer (runs inside the canonical CodeMe/OpenHands loop).
# This does not use n8n or Paperclip. SearXNG is optional; GitHub and npm are
# queried directly as bounded technical evidence backends.
CODEME_RESEARCH_ENABLED=true
CODEME_RESEARCH_SEARXNG_URL=http://127.0.0.1:8080
CODEME_RESEARCH_TIMEOUT_MS=12000
CODEME_RESEARCH_MAX_SOURCES=8
# Optional GitHub token for higher API rate limits. Keep secrets only in .env.
CODEME_GITHUB_TOKEN=

# Local Flow-style voice dictation used by the Composer mic button.
# The setup script installs whisper.cpp/model under ~/.codeme, which CodeMe
# auto-detects. Set these only when using custom paths.
CODEME_WHISPER_BIN=
CODEME_WHISPER_MODEL=
CODEME_VOICE_CLEANUP=true
CODEME_VOICE_OLLAMA_URL=http://127.0.0.1:11434
CODEME_VOICE_OLLAMA_MODEL=qwen3.5:9b

# Local Ollama on the Mac.
CODEME_LOCAL_OLLAMA_URL=http://127.0.0.1:11434

# Remote Ollama on codeme-ai over Tailscale.
# codeme-ai Tailscale address: 100.81.117.90
CODEME_SERVER_OLLAMA_URL=http://100.81.117.90:11434

# Backward-compatible default used by non-Composer probes/tests.
CODEME_OLLAMA_URL=http://127.0.0.1:11434

# Paperclip is installed but disabled for the current CodeMe-only runtime.
# Re-enable both switches later when Paperclip is intentionally restored.
CODEME_PAPERCLIP_MASTER_ENABLED=false
CODEME_PAPERCLIP_ENABLED=false
CODEME_PAPERCLIP_PORT=7788
CODEME_PAPERCLIP_BRIDGE_TOKEN=
PAPERCLIP_API_URL=http://127.0.0.1:3100

# Legacy/single-agent controller identity. Multi-agent setup keeps this as the
# controller fallback and adds per-agent identities below.
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_CONTROLLER_AGENT_ID=

# Multi-agent routing. Keep the key JSON only in your local .env.
# Example roles JSON:
# {"<controller-id>":"controller","<product-id>":"product","<cto-id>":"cto","<research-id>":"research","<developer-id>":"developer","<test-id>":"test","<reviewer-id>":"reviewer"}
CODEME_PAPERCLIP_AGENT_ROLES_JSON='{}'
CODEME_PAPERCLIP_AGENT_KEYS_JSON='{}'

# When multi-agent roles are configured, controller-assigned tasks are routed
# through Product -> Architect -> optional Research -> Developer -> Test -> Reviewer. Set false to fall back to the
# controller's direct single-agent execution path.
CODEME_PAPERCLIP_TEAM_ORCHESTRATION=false

# Used by qualification scripts that need a specific model.
CODEME_QWEN_MODEL=qwen3.5:9b
